# 复制成 .env。不要提交真实密钥；可 chmod 600 .env。
# 本地构建用默认值；直接拉取 Actions 镜像时改为 ghcr.io/wttwins/hermes-workbuddy-integration:latest。
IMAGE=workbuddy-openai-proxy:local
# 容器应用端口：必须是 1-65535 的整数，docker run -e PORT=9000 同样支持。
PORT=8788
# 宿主映射端口：当前机器 8788 已有 Node 服务，试运行建议使用其他空闲端口。
HOST_PORT=9000
# 默认只发布到宿主回环地址；可信局域网访问才显式改成 0.0.0.0。
BIND_ADDRESS=127.0.0.1
# 容器内部必须监听可达接口。一般保持 0.0.0.0。
HOST=0.0.0.0
# Docker 宿主访问在容器看来属于远程。需要控制台时改 true，仍需主 API Key 登录。
ALLOW_REMOTE_CONSOLE=false
# 留空：保留数据卷已有 Key；初次运行生成随机 Key。不要在聊天中发送真实 Key。
API_KEY=
# 可选：容器内挂载的密钥文件路径。不能同时设置非空 API_KEY。
API_KEY_FILE=
# 默认命名卷。也可以填写绝对路径；绑定目录需让 UID 1000 可读写。
DATA_DIR=workbuddy-data
